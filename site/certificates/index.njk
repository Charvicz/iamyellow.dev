<!-- Modal pro full-screen certifikát -->
<div id="cert-modal" class="modal" role="dialog" aria-labelledby="modal-title" aria-hidden="true">
  <div class="modal-content">
    <button class="modal-close" aria-label="Zavřít">×</button>
    <img id="modal-image" src="" alt="" loading="lazy">
    <div id="modal-desc" class="modal-desc"></div>
  </div>
</div>

<style>
/* 2 sloupce */
#cert-list {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
  gap: 2rem;
  max-width: 1000px;
  margin: 0 auto;
}
.cert { cursor: pointer; }
@media (max-width: 850px) { #cert-list { grid-template-columns: 1fr; } }
</style>

<script>
document.querySelectorAll('.cert').forEach(c => c.onclick = () => {
  document.getElementById('modal-image').src = c.querySelector('img').src;
  document.getElementById('cert-modal').classList.add('active');
});
document.querySelector('.modal-close').onclick = () => document.getElementById('cert-modal').classList.remove('active');
</script>

