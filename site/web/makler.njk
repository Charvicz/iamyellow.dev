---
pagination:
  data: makleri_data
  size: 1
  alias: makler
permalink: "web/{{ makler.cele_jmeno | slugify }}/index.html"
layout: layout.njk
---

<div class="container mx-auto px-4 py-8" x-data="{ maxPrice: 20000000 }">
    <!-- Profil makléře -->
    <div class="flex flex-col md:flex-row gap-8 items-center bg-white p-6 rounded-xl shadow-sm mb-12">
        <img src="/assets/images/export_makleri/{{ makler.id }}.jpg" 
             alt="{{ makler.cele_jmeno }}" 
             class="w-48 h-48 rounded-full object-cover shadow-md"
             onerror="this.src='/assets/images/potensic-fallback.jpg.jpg'">
        
        <div>
            <h1 class="text-3xl font-bold">{{ makler.cele_jmeno }}</h1>
            <p class="text-blue-600 font-medium">Realitní makléř</p>
            <div class="mt-4 flex gap-4">
                <a href="mailto:{{ makler.email }}" class="text-gray-600 hover:text-blue-600 flex items-center gap-2">
                    <span>📧</span> {{ makler.email }}
                </a>
            </div>
            <a href="{{ makler.url_profilu }}" target="_blank" class="mt-4 inline-block text-sm text-gray-400 underline">
                Původní profil na RealitníServery.cz
            </a>
        </div>
    </div>

    <!-- Filtr ceny (pomocí Alpine.js pro okamžitou reakci) -->
    <div class="mb-8 bg-gray-50 p-4 rounded-lg">
        <label class="block text-sm font-bold mb-2">Filtrovat podle ceny: <span x-text="new Intl.NumberFormat('cs-CZ').format(maxPrice)"></span> Kč</label>
        <input type="range" min="0" max="30000000" step="500000" x-model="maxPrice" class="w-full h-2 bg-blue-200 rounded-lg appearance-none cursor-pointer">
    </div>

    <!-- Seznam nabídek -->
    <h2 class="text-2xl font-bold mb-6">Aktuální nabídky</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {% for nabidka in makler.nabidky %}
        <div class="bg-white rounded-xl shadow-sm overflow-hidden border border-gray-100 transition-all hover:shadow-md"
             x-show="{{ nabidka.cena }} <= maxPrice">
            <div class="h-48 overflow-hidden relative">
                <img src="{{ nabidka.foto_url }}" alt="{{ nabidka.titulek }}" class="w-full h-full object-cover">
                <div class="absolute top-2 right-2 bg-blue-600 text-white px-2 py-1 rounded text-sm font-bold">
                    {{ nabidka.cena | localeString }} Kč
                </div>
            </div>
            <div class="p-4">
                <h3 class="font-bold text-lg mb-2">{{ nabidka.titulek }}</h3>
                <p class="text-gray-600 text-sm line-clamp-3">{{ nabidka.popis }}</p>
                <button class="mt-4 w-full bg-gray-900 text-white py-2 rounded-lg font-bold hover:bg-black transition-colors">
                    Detail nemovitosti
                </button>
            </div>
        </div>
        {% else %}
        <p class="text-gray-500 italic">Tento makléř momentálně nemá žádné veřejné nabídky.</p>
        {% endfor %}
    </div>
</div>
