---
pagination:
  data: makleri_data
  size: 1
  alias: stock
permalink: "/stocks/{{ stock.id }}/index.html"
layout: "layout.njk"
---
<div class="max-w-6xl mx-auto px-4 py-8">
  <div class="flex flex-wrap md:flex-nowrap gap-8">
    
    <div class="w-full md:w-1/3 bg-slate-900 text-white rounded-2xl p-6 shadow-xl border-b-4 border-yellow-400">
      <img src="{{ stock.profilova_fotka_url }}" alt="{{ stock.cele_jmeno }}" class="w-24 h-24 rounded-full mb-4 border-2 border-slate-700">
      <h1 class="text-3xl font-bold mb-2">{{ stock.cele_jmeno }}</h1>
      <span class="inline-block bg-slate-800 text-yellow-400 px-3 py-1 rounded-full text-sm font-semibold mb-6">
        Realitní makléř
      </span>
      
      <div class="space-y-4">
        <div class="flex justify-between border-b border-slate-700 pb-2">
          <span class="text-slate-400">E-mail</span>
          <span class="text-sm font-mono">{{ stock.email }}</span>
        </div>
        <div class="flex justify-between">
          <span class="text-slate-400">Nabídky</span>
          <span class="text-green-400">{{ stock.nabidky | length }} nemovitostí</span>
        </div>
      </div>
    </div>

    <div class="w-full md:w-2/3 bg-white rounded-2xl p-6 shadow-sm border border-slate-100">
      <h2 class="text-xl font-semibold text-slate-800 mb-6">Nabídky nemovitostí</h2>
      {% for nabidka in stock.nabidky %}
      <div class="flex gap-4 mb-4 border-b pb-4">
        <img src="{{ nabidka.foto_url }}" alt="{{ nabidka.titulek }}" class="w-20 h-20 object-cover rounded-lg">
        <div>
          <h3 class="font-semibold text-slate-800">{{ nabidka.titulek }}</h3>
          <p class="text-yellow-600 font-bold">{{ nabidka.cena | localeString }} {{ nabidka.mena }}</p>
          <p class="text-slate-500 text-sm line-clamp-2">{{ nabidka.popis }}</p>
        </div>
      </div>
      {% endfor %}
    </div>

  </div>
</div>