---
pagination:
  data: makleri_data
  size: 1
  alias: stock
permalink: "/stocks/{{ stock.slug }}/index.html"
layout: "layout.njk"
---


<div class="max-w-6xl mx-auto px-4 py-8">
  <div class="flex flex-wrap md:flex-nowrap gap-8">
    
    <div class="w-full md:w-1/3 bg-slate-900 text-white rounded-2xl p-6 shadow-xl border-b-4 border-yellow-400">
      <img src="/assets/images/stocks/{{ stock.image }}" alt="{{ stock.name }}" class="w-24 h-24 rounded-full mb-4 border-2 border-slate-700">
      <h1 class="text-3xl font-bold mb-2">{{ stock.name }}</h1>
      <span class="inline-block bg-slate-800 text-yellow-400 px-3 py-1 rounded-full text-sm font-semibold mb-6">
        {{ stock.category }}
      </span>
      
      <div class="space-y-4">
        <div class="flex justify-between border-b border-slate-700 pb-2">
          <span class="text-slate-400">Aktuální cena</span>
          <span class="text-2xl font-mono">${{ stock.price }}</span>
        </div>
        <div class="flex justify-between">
          <span class="text-slate-400">Změna</span>
          <span class="{% if '-' in stock.change %}text-red-400{% else %}text-green-400{% endif %}">
            {{ stock.change }}
          </span>
        </div>
      </div>
    </div>

    <div class="w-full md:w-2/3 bg-white rounded-2xl p-6 shadow-sm border border-slate-100">
      <h2 class="text-xl font-semibold text-slate-800 mb-6">Výkonnostní vizualizace</h2>
      <canvas id="stockChart" width="400" height="200"></canvas>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
  const ctx = document.getElementById('stockChart').getContext('2d');
  new Chart(ctx, {
    type: 'line',
    data: {
      labels: ['Po', 'Út', 'St', 'Čt', 'Pá'],
      datasets: [{
        label: 'Trend (Simulace)',
        data: [{{ stock.price }} * 0.95, {{ stock.price }} * 0.98, {{ stock.price }}, {{ stock.price }} * 1.02, {{ stock.price }}],
        borderColor: '#facc15', // Yellow-400
        backgroundColor: 'rgba(250, 204, 21, 0.1)',
        fill: true,
        tension: 0.4
      }]
    },
    options: {
      responsive: true,
      plugins: { legend: { display: false } },
      scales: { y: { grid: { display: false } }, x: { grid: { display: false } } }
    }
  });
</script>