layout: layout.njk
title: Potensic Atom | Technologie v detailu
---

<link rel="stylesheet" href="/assets/potensic-experience.css">

<main class="experience-container">
    <!-- WebGL Canvas -->
    <canvas id="drone-canvas"></canvas>

    <!-- Overlay UI / HUD -->
    <div class="hud-overlay">
        <div class="hud-line"></div>
        <span class="hud-status">SYSTEM: ONLINE</span>
    </div>

    <!-- Scroll Content -->
    <section class="v-section" data-scene="hero">
        <div class="content">
            <h1 class="reveal-text">Potensic Atom</h1>
            <p class="subtitle">Definice preciznosti v 249 gramech.</p>
        </div>
    </section>

    <section class="v-section" data-scene="stabilization">
        <div class="content side-aligned">
            <h2>3-osá stabilizace</h2>
            <p>Mechanický gimbal eliminující každý záchvěv větru. Plynulost, která bere dech.</p>
        </div>
    </section>

    <section class="v-section" data-scene="vision">
        <div class="content">
            <h2>4K PixSync 3.0</h2>
            <p>Křišťálově čistý přenos obrazu na vzdálenost až 6 km. Vaše oči v oblacích.</p>
        </div>
    </section>

    <section class="v-section" data-scene="specs">
        <div class="grid-specs">
            <div class="spec-item"><span>Váha</span><strong>< 249g</strong></div>
            <div class="spec-item"><span>Odolnost</span><strong>Level 5</strong></div>
            <div class="spec-item"><span>Let</span><strong>31 min</strong></div>
        </div>
    </section>
</main>

<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/0.160.0/three.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>
