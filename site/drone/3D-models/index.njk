<section class="hero">
  <div class="hero__bg"></div>
  <div class="hero__content container">
    <div class="hero__copy">
      <p class="eyebrow">DRONE / 3D MODELS</p>
      <h1>3D modely zachycené dronem.</h1>
      <p class="hero__lead">Interaktivní galerie ve vysoké kvalitě, ready pro AR/VR.</p>

      <div class="hero__actions">
        <a href="#models" class="btn btn--primary">Zobrazit modely</a>
      </div>
    </div>

    <div class="hero__visual">
      <iframe 
        src="https://poly.cam/capture/3abf713d-af68-4b54-bc80-883f9f9fd379/embed" 
        title="Polycam capture viewer" 
        style="height:100%;width:100%;max-height:720px;max-width:1280px;min-height:280px;min-width:280px" 
        frameborder="0">
      </iframe>
    </div>
  </div>
</section>

<section class="controls container" id="about">
  <div class="controls__left">
    <h2>Vyber model</h2>
  </div>
  <div class="controls__right">
    <button class="chip is-active" data-filter="all">Vše</button>
    <button class="chip" data-filter="industrial">Průmysl</button>
    <button class="chip" data-filter="urban">Město</button>
    <button class="chip" data-filter="nature">Příroda</button>
  </div>
</section>

<section class="models container" id="models">
  <article class="model-card" data-category="industrial">
    <div class="model-card__media">
      <div class="model-card__badge">Průmysl</div>
      <div class="model-card__preview"></div>
    </div>
    <div class="model-card__body">
      <h3>Hangár Scan</h3>
      <div class="model-card__meta">
        <span>8.1M bodů</span>
      </div>
    </div>
  </article>

  <article class="model-card" data-category="urban">
    <div class="model-card__media">
      <div class="model-card__badge">Město</div>
      <div class="model-card__preview"></div>
    </div>
    <div class="model-card__body">
      <h3>City Block</h3>
      <div class="model-card__meta">
        <span>6.5M bodů</span>
      </div>
    </div>
  </article>

  <article class="model-card" data-category="nature">
    <div class="model-card__media">
      <div class="model-card__badge">Příroda</div>
      <div class="model-card__preview"></div>
    </div>
    <div class="model-card__body">
      <h3>Forest Edge</h3>
      <div class="model-card__meta">
        <span>4.2M bodů</span>
      </div>
    </div>
  </article>
</section>