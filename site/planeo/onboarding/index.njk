---
title: "Onboarding"
layout: "layout.njk"
---

<section class="onb">
  <div class="onb__wrap">
    <h1 class="onb__title">Ještě 2 rychlý otázky 👇</h1>
    <p class="onb__sub">Ať víme, odkud jsi a co děláš.</p>

    <div class="onb__card">
      <div class="field">
        <span>Pobočka</span>
        <select id="branch"></select>
      </div>

      <div class="field">
        <span>Pozice</span>
        <select id="role">
          <option value="vedouci">Vedoucí prodejny</option>
          <option value="zastupce">Zástupce vedoucího</option>
          <option value="admin">Administrativní pracovník</option>
          <option value="prodavac">Prodavač</option>
          <option value="logistik">Logistik</option>
          <option value="jine">Jiné</option>
        </select>
      </div>

      <button class="onb__btn" id="saveBtn">Uložit</button>
      <div class="onb__err" id="err" hidden></div>
    </div>
  </div>
</section>
