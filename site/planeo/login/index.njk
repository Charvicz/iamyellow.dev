---
title: "Planeo — Přihlášení"
layout: "layout.njk"
---

<section class="auth">
  <h1>Planeo login</h1>
  <p class="sub">Číslo/ID + PIN (4 čísla). Hotovo.</p>

  <div class="authTabs">
    <button id="tabLogin" class="tab is-active" type="button">Přihlásit</button>
    <button id="tabRegister" class="tab" type="button">Registrovat</button>
  </div>

  <label class="field">
    <span>Číslo / ID</span>
    <input id="phone" type="text" inputmode="numeric" maxlength="5" placeholder="např. 69420">
  </label>

  <label class="field">
    <span>PIN (4 čísla)</span>
    <input id="pin" type="password" inputmode="numeric" maxlength="4" placeholder="1234">
  </label>

  <button id="goBtn" class="btn btn--big" type="button">Pokračovat</button>
  <div id="err" class="err" hidden></div>
</section>

<link rel="stylesheet" href="/assets/planeo-login.css">
<script type="module" src="/assets/planeo-login.js"></script>
